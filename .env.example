# GEMINI_API_KEY: Optional Gemini AI API call secret
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The base URL of the deployment (e.g. https://directhome-bc.vercel.app)
APP_URL="http://localhost:3000"

# --- Supabase Architecture (Auth, Postgres, Storage, RLS) ---
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-for-admin-rpc"

# --- Resend Email Notifications ---
RESEND_API_KEY="re_123456789"
NOTIFICATION_FROM_EMAIL="notifications@directhome.ca"

# --- Maps (Free OpenStreetMap / MapLibre default) ---
# MapLibre utilizes free OpenStreetMap raster tiles without requiring a paid token.

# --- Google Analytics 4 (optional). Leave empty to keep analytics fully off. ---
# Loads only after a visitor clicks "Accept analytics".
VITE_GA_MEASUREMENT_ID=""
